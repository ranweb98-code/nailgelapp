# ---- Database (SQLite local file) ----
DATABASE_URL="file:./dev.db"

# ---- Admin panel ----
# סיסמת הכניסה לפאנל הניהול של בעלת העסק
ADMIN_PASSWORD="gel1234"
# מחרוזת אקראית לחתימת ה-session cookie (שני אותה לערך ארוך ואקראי בפרודקשן)
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- Email (Resend) ----
# אם לא ממולא - האימיילים יודפסו ל-console (מצב preview) והדמו עדיין יעבוד
RESEND_API_KEY=""
# כתובת השולח (חייבת להיות דומיין מאומת ב-Resend; ברירת מחדל לבדיקות)
EMAIL_FROM="Gel Studio <onboarding@resend.dev>"
# כתובת המייל של בעלת העסק - לשם נשלחות התראות על תורים חדשים
OWNER_EMAIL="owner@example.com"

# ---- כללי ----
# כתובת הבסיס של האתר (לשימוש בקישורים באימיילים)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# כמה שעות לפני התור לשלוח תזכורת
REMINDER_HOURS_BEFORE="24"
# הפעלת מתזמן התזכורות האוטומטי בפיתוח (true/false)
ENABLE_CRON="true"
